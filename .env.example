# Copy this file to .env and fill in values as needed. Never commit .env itself.

# --- AI analyst LLM (optional) ---
# Leave LLM_API_KEY blank to run the AI analyst with its built-in
# deterministic templates instead of an LLM — both are equally grounded in
# real numbers, the LLM just phrases answers more naturally.
#
# Any OpenAI-compatible endpoint works. Groq's free tier is a good default
# (fast, no cost for light use): https://console.groq.com
LLM_API_KEY=gsk_your_key_here
# GROQ_API_KEY is also accepted if you prefer Groq's standard variable name.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1

# --- MLflow ---
# Experiment name used by ml/train.py. On Databricks, set this to a full
# workspace path instead, e.g. /Users/you@company.com/Retail-Sales-Forecasting
RETAIL_MLFLOW_EXPERIMENT=Retail-Sales-Forecasting

# --- Pipeline storage root (local demo only) ---
# On Databricks, this is provided instead via the "base_path" notebook
# widget and normally points at a DBFS/Volumes path.
RETAIL_BASE_PATH=./dbfs_local
